 1: // lib/firebase.ts
 2: // Inicialización de Firebase — SOLO autenticación con Google (sin backend propio).
 3: // Las variables NEXT_PUBLIC_FIREBASE_* se inyectan en build time (ver Dockerfile).
 4: // Este archivo NO debe commitearse con valores hardcodeados — siempre usa env vars.
 5: 
 6: import { initializeApp, getApps, type FirebaseApp } from 'firebase/app'
 7: import { getAuth, GoogleAuthProvider, type Auth } from 'firebase/auth'
 8: 
 9: const firebaseConfig = {
10:   apiKey:     process.env.NEXT_PUBLIC_FIREBASE_API_KEY,
11:   authDomain: process.env.NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
12:   projectId:  process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID,
13:   appId:      process.env.NEXT_PUBLIC_FIREBASE_APP_ID,
14: }
15: 
16: let app:            FirebaseApp | undefined
17: let auth:           Auth | undefined
18: let googleProvider: GoogleAuthProvider | undefined
19: 
20: // Solo inicializar si las vars están presentes.
21: // En build sin vars, evita crash — en runtime, HeaderAuth avisa por consola.
22: if (firebaseConfig.apiKey && firebaseConfig.projectId) {
23:   app            = getApps().length ? getApps()[0]! : initializeApp(firebaseConfig)
24:   auth           = getAuth(app)
25:   googleProvider = new GoogleAuthProvider()
26: 
27:   // Forzar selección de cuenta en cada login (mejor UX multi-cuenta Google)
28:   googleProvider.setCustomParameters({ prompt: 'select_account' })
29: } else {
30:   console.warn(
31:     '[Firebase] Variables de entorno no configuradas. ' +
32:     'Asegurate de tener NEXT_PUBLIC_FIREBASE_* en .env.local o en los secrets del CI.'
33:   )
34: }
35: 
36: export { app, auth, googleProvider }
