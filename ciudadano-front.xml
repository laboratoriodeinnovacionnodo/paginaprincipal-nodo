 54:       span: HTMLSpanElement
 55:       accentClass: string   // clase CSS del wrapper accent, si existe
 56:       isAccent: boolean
 57:     }
 58: 
 59:     const wordSlots: WordSlot[] = []
 60: 
 61:     // Procesa un fragmento de texto, dividiendo en palabras + espacios.
 62:     // Cada "token" (palabra o espacio) se convierte en un span animable.
 63:     function createWordSpan(word: string, accentClass: string, isAccent: boolean): HTMLSpanElement {
 64:       const sp = document.createElement("span")
 65:       // inline-block para poder transformar verticalmente
 66:       // overflow hidden contiene el movimiento dentro del bounding box
 67:       sp.style.cssText = [
 68:         "display:inline-block",
 69:         "overflow:hidden",
 70:         "vertical-align:bottom",
 71:         // El padding-bottom compensa el overflow:hidden que recorta descenders
 72:         "padding-bottom:0.1em",
 73:         "margin-bottom:-0.1em",
 74:       ].join(";")
 75: 
 76:       // Span interno — este es el que se anima
 77:       const inner = document.createElement("span")
 78:       inner.style.cssText = [
 79:         "display:inline-block",
 80:         "opacity:0",
 81:         "transform:translateY(60%) skewY(3deg)",
 82:         "filter:blur(4px)",
 83:         `transition:opacity ${duration}ms cubic-bezier(0.16,1,0.3,1), transform ${duration}ms cubic-bezier(0.16,1,0.3,1), filter ${duration}ms cubic-bezier(0.16,1,0.3,1)`,
 84:         "will-change:transform,opacity,filter",
 85:       ].join(";")
 86: 
 87:       if (isAccent && accentClass) {
 88:         inner.className = accentClass
 89:       }
 90: 
 91:       inner.textContent = word
 92:       sp.appendChild(inner)
