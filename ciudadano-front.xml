## File: components/chatbot/siri-frame.tsx
```typescript
 1: "use client"
 2: 
 3: /**
 4:  * <SiriFrame>
 5:  *
 6:  * Glow de colores de marca pegado a los bordes de la pantalla que se va
 7:  * perdiendo/disolviendo hacia el centro (vignette invertida), como el
 8:  * efecto de Siri al escuchar. Cubre buena parte de la pantalla — el
 9:  * centro queda limpio para leer, los bordes se funden en color.
10:  *
11:  * - CSS puro (conic-gradient + radial mask), sin WebGL ni dependencias
12:  * - `active` agranda la zona de color, sube opacidad y acelera el giro
13:  *   (ej: mientras el bot "piensa")
14:  * - Respeta prefers-reduced-motion (deja el color fijo, sin girar)
15:  */
16: 
17: // Usa los tokens de marca definidos en :root (globals.css) en vez de
18: // colores hardcodeados — primary (azul NODO) + chart-4/2/5 como
19: // secundario/terciario/acento, así el glow siempre matchea el theme.
20: // Las variables ya vienen con oklch(...) completo en :root, por eso se
21: // usan directo con var() sin volver a envolver en oklch().
22: const BRAND_GRADIENT =
23:   "conic-gradient(from 0deg at 50% 50%, var(--primary), var(--accent), var(--primary), var(--accent), var(--primary))";  "conic-gradient(from 0deg at 50% 50%, var(--primary), var(--chart-4), var(--chart-2), var(--chart-5), var(--primary))"
24: 
25: interface Props {
26:   active?: boolean
27: }
28: 
29: export function SiriFrame({ active = false }: Props) {
30:   // Radio (en % del gradiente) donde arranca transparente y donde ya
31:   // está 100% coloreado. Más chico el primero = más pantalla cubierta.
32:   const innerStop = active ? "14%" : "22%"
33:   const outerStop = active ? "72%" : "88%"
34: 
35:   const maskImage = `radial-gradient(transparent ${innerStop}, black ${outerStop})`
36: 
37:   return (
38:     <div className="pointer-events-none absolute inset-0 overflow-hidden">
39:       {/* Capa base — tinte muy leve, da profundidad detrás del glow principal */}
40:       <div
41:         className="absolute inset-0 transition-opacity duration-700 ease-out"
42:         style={{ opacity: active ? 0.06 : 0.03 }}
43:       >
44:         <div
45:           className="siri-frame-spin absolute -inset-1/2 h-[200%] w-[200%]"
46:           style={{
47:             background: BRAND_GRADIENT,
48:             filter: "blur(140px)",
49:             animationDuration: active ? "12s" : "24s",
50:           }}
51:         />
52:       </div>
53: 
54:       {/* Glow principal — pierde color hacia el centro (efecto Siri) */}
55:       <div
56:         className="absolute inset-0 transition-opacity duration-700 ease-out"
57:         style={{
58:           opacity: active ? 0.95 : 0.6,
59:           maskImage,
60:           WebkitMaskImage: maskImage,
61:         }}
62:       >
63:         <div
64:           className="siri-frame-spin absolute -inset-1/2 h-[200%] w-[200%]"
65:           style={{
66:             background: BRAND_GRADIENT,
67:             filter: `blur(${active ? 46 : 34}px)`,
68:             animationDuration: active ? "6s" : "15s",
69:           }}
70:         />
71:       </div>
72: 
73:       <style jsx>{`
74:         .siri-frame-spin {
75:           animation-name: siri-frame-rotate;
76:           animation-timing-function: linear;
77:           animation-iteration-count: infinite;
78:         }
79:         @keyframes siri-frame-rotate {
80:           from {
81:             transform: rotate(0deg);
82:           }
83:           to {
84:             transform: rotate(360deg);
85:           }
86:         }
87:         @media (prefers-reduced-motion: reduce) {
88:           .siri-frame-spin {
89:             animation: none;
90:           }
91:         }
92:       `}</style>
93:     </div>
94:   )
95: }
