 1: /**
 2:  * lib/noticias/api.ts
 3:  * Fetcher robusto que maneja todos los shapes de respuesta del back.
 4:  */
 5: import type { Noticia, NoticiasResponse } from './types'
 6: 
 7: const API_URL = (
 8:   process.env.NOTICIAS_API_URL ??
 9:   process.env.NEXT_PUBLIC_API_URL ??
10:   ''
11: ).replace(/\/$/, '')
12: 
13: const EMPTY: NoticiasResponse = { items: [], total: 0, page: 1, limit: 9, pages: 0 }
14: 
15: /** Extrae el array de items de cualquier shape que devuelva el back */
16: function extractItems(json: unknown): Noticia[] {
17:   if (!json || typeof json !== 'object') return []
18:   const j = json as Record<string, unknown>
19: 
20:   // { data: { items: [] } }
21:   if (j.data && typeof j.data === 'object') {
22:     const d = j.data as Record<string, unknown>
23:     if (Array.isArray(d.items)) return d.items as Noticia[]
24:     if (Array.isArray(d.data))  return d.data  as Noticia[]
25:     if (Array.isArray(d))       return d        as Noticia[]
26:   }
27: 
28:   // { items: [] }
29:   if (Array.isArray(j.items)) return j.items as Noticia[]
30: 
31:   // { data: [] }
32:   if (Array.isArray(j.data)) return j.data as Noticia[]
33: 
34:   // respuesta directa []
35:   if (Array.isArray(json)) return json as Noticia[]
36: 
37:   return []
38: }
39: 
40: function extractMeta(json: unknown, items: Noticia[]): Omit<NoticiasResponse, 'items'> {
41:   const j = (json && typeof json === 'object' ? json : {}) as Record<string, unknown>
42:   const d = (j.data && typeof j.data === 'object' ? j.data : j) as Record<string, unknown>
43:   return {
44:     total: Number(d.total ?? items.length),
45:     page:  Number(d.page  ?? 1),
46:     limit: Number(d.limit ?? 9),
47:     pages: Number(d.pages ?? Math.ceil(items.length / 9)),
48:   }
49: }
50: 
51: export async function getNoticias(
52:   params: { page?: number; limit?: number; search?: string; categoriaId?: string; tagId?: string } = {},
53: ): Promise<NoticiasResponse> {
54:   if (!API_URL) {
55:     console.warn('[noticias-api] NOTICIAS_API_URL no definida')
56:     return EMPTY
57:   }
58: 
59:   try {
60:     const qs = new URLSearchParams()
61:     qs.set('estado', 'PUBLICADA')
62:     qs.set('page',   String(params.page  ?? 1))
63:     qs.set('limit',  String(params.limit ?? 9))
64:     if (params.search)      qs.set('search',      params.search)
65:     if (params.categoriaId) qs.set('categoriaId', params.categoriaId)
66:     if (params.tagId)       qs.set('tagId',       params.tagId)
67: 
68:     const res = await fetch(`${API_URL}/api/v1/noticias?${qs}`, { cache: 'no-store' })
69: 
70:     if (!res.ok) {
71:       console.error(`[noticias-api] GET /noticias → ${res.status}`)
72:       return EMPTY
73:     }
74: 
75:     const json: unknown = await res.json()
76:     const items = extractItems(json)
77:     const meta  = extractMeta(json, items)
78:     return { items, ...meta }
79:   } catch (err) {
80:     console.error('[noticias-api] Error:', err)
81:     return EMPTY
82:   }
83: }
84: 
85: export async function getNoticiaBySlug(slug: string): Promise<Noticia | null> {
86:   if (!API_URL) return null
87:   try {
88:     const res = await fetch(`${API_URL}/api/v1/noticias/${slug}`, { cache: 'no-store' })
89:     if (!res.ok) return null
90:     const json = await res.json() as { data?: Noticia } & Noticia
91:     return (json.data ?? json) as Noticia
92:   } catch {
93:     return null
94:   }
95: }
