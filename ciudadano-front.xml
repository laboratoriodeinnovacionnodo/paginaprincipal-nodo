## File: components/counter-stat.tsx
```typescript
 1: "use client"
 2: 
 3: import { useEffect, useRef, useState } from "react"
 4: 
 5: interface CounterStatProps {
 6:   end: number
 7:   label: string
 8:   suffix?: string
 9:   duration?: number
10: }
11: 
12: export function CounterStat({ end, label, suffix = "+", duration = 2000 }: CounterStatProps) {
13:   const [count, setCount] = useState(0)
14:   const [isVisible, setIsVisible] = useState(false)
15:   const ref = useRef<HTMLDivElement>(null)
16: 
17:   useEffect(() => {
18:     const observer = new IntersectionObserver(
19:       ([entry]) => {
20:         if (entry.isIntersecting && !isVisible) {
21:           setIsVisible(true)
22:         }
23:       },
24:       { threshold: 0.3 },
25:     )
26: 
27:     if (ref.current) {
28:       observer.observe(ref.current)
29:     }
30: 
31:     return () => {
32:       if (ref.current) {
33:         observer.unobserve(ref.current)
34:       }
35:     }
36:   }, [isVisible])
37: 
38:   useEffect(() => {
39:     if (!isVisible) return
40: 
41:     const startTime = Date.now()
42:     const endTime = startTime + duration
43: 
44:     const updateCount = () => {
45:       const now = Date.now()
46:       const progress = Math.min((now - startTime) / duration, 1)
47: 
48:       // Easing function for smooth animation
49:       const easeOutQuart = 1 - Math.pow(1 - progress, 4)
50:       const currentCount = Math.floor(easeOutQuart * end)
51: 
52:       setCount(currentCount)
53: 
54:       if (now < endTime) {
55:         requestAnimationFrame(updateCount)
56:       } else {
57:         setCount(end)
58:       }
59:     }
60: 
61:     requestAnimationFrame(updateCount)
62:   }, [isVisible, end, duration])
63: 
64:   return (
65:     <div ref={ref}>
66:       <div className="text-4xl md:text-5xl font-bold text-primary">
67:         {count.toLocaleString("es-AR")}
68:         {suffix}
69:       </div>
70:       <div className="text-sm text-muted-foreground mt-1 text-white/75">{label}</div>
71:     </div>
72:   )
73: }
```

