19: import { useState, useCallback } from "react"
20: import { Loader2 } from "lucide-react"
21: import { useAuth } from "@/contexts/auth-context"
22: import { buildRegistroUrl } from "@/lib/registro-link"
23: 
24: interface Props {
25:   slug:       string
26:   className?: string
27:   children?:  React.ReactNode
28: }
29: 
30: export function InscribirseButton({ slug, className = "", children }: Props) {
31:   const { user } = useAuth()
32:   const [loading, setLoading] = useState(false)
33: 
34:   const handleClick = useCallback(async () => {
35:     setLoading(true)
36:     try {
