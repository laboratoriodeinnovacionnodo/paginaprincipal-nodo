  3: /**
  4:  * contexts/auth-context.tsx
  5:  *
  6:  * AuthProvider — gestiona la sesión Firebase + perfil en ciudadano-back.
  7:  *
  8:  * Flujo:
  9:  *   1. signInWithPopup (Google) → Firebase autentica
 10:  *   2. onAuthStateChanged dispara → obtenemos idToken
 11:  *   3. POST /auth/login en ciudadano-back → upsert del ciudadano en BD
 12:  *   4. GET /ciudadanos/me → perfil completo con lineas
 13:  *
 14:  * Contexto expone:
 15:  *   user    — Firebase User (displayName, email, photoURL, etc.)
 16:  *   perfil  — CiudadanoDB (id, dni, phone, city, lineas, etc.) | null
 17:  *   loading — true mientras se resuelve la sesión inicial
 18:  *   loginWithGoogle()
 19:  *   logout()
 20:  *   refreshPerfil() — re-fetch manual del perfil (útil tras PATCH /me)
 21:  */
 22: 
 23: import {
 24:   createContext,
 25:   useContext,
 26:   useEffect,
 27:   useState,
 28:   useCallback,
 29:   type ReactNode,
 30: } from "react"
 31: import {
 32:   onAuthStateChanged,
 33:   signInWithPopup,
 34:   signOut as firebaseSignOut,
 35:   type User,
 36: } from "firebase/auth"
 37: import { auth, googleProvider } from "@/lib/firebase"
 38: import {
 39:   loginCiudadano,
 40:   getMiPerfil,
 41:   type CiudadanoDB,
 42: } from "@/lib/ciudadano-api"
 43: 
 44: interface AuthContextValue {
 45:   user: User | null
 46:   perfil: CiudadanoDB | null
 47:   loading: boolean
 48:   loginWithGoogle: () => Promise<void>
 49:   logout: () => Promise<void>
 50:   refreshPerfil: () => Promise<void>
 51: }
 52: 
 53: const AuthContext = createContext<AuthContextValue | undefined>(undefined)
 54: 
 55: // Errores de Firebase que NO son fallos reales
 56: const IGNORED_FIREBASE_ERRORS = new Set([
 57:   "auth/popup-closed-by-user",
 58:   "auth/cancelled-popup-request",
 59: ])
 60: 
 61: function isIgnoredFirebaseError(error: unknown): boolean {
 62:   if (!error || typeof error !== "object") return false
 63:   const code = (error as { code?: string }).code
 64:   return typeof code === "string" && IGNORED_FIREBASE_ERRORS.has(code)
 65: }
 66: 
 67: export function AuthProvider({ children }: { children: ReactNode }) {
 68:   const [user, setUser] = useState<User | null>(null)
 69:   const [perfil, setPerfil] = useState<CiudadanoDB | null>(null)
 70:   const [loading, setLoading] = useState(true)
 71: 
 72:   /**
 73:    * Sincroniza con ciudadano-back: hace upsert y luego fetcha el perfil completo.
 74:    * Se llama tanto en el primer login como en cada recarga de sesión.
 75:    */
 76:   const syncConBack = useCallback(async (firebaseUser: User) => {
 77:     try {
 78:       const idToken = await firebaseUser.getIdToken()
 79: 
 80:       // Upsert — crea o actualiza el ciudadano en la BD
 81:       await loginCiudadano(idToken)
 82: 
 83:       // Perfil completo con lineas
 84:       const ciudadanoDB = await getMiPerfil(idToken)
 85:       setPerfil(ciudadanoDB)
 86:     } catch (err) {
 87:       // Si el back no está disponible (NEXT_PUBLIC_CIUDADANO_API_URL no seteada
 88:       // o error de red), logueamos pero NO rompemos la sesión Firebase.
 89:       console.warn("[auth] ciudadano-back no disponible o no configurado:", err)
 90:       setPerfil(null)
 91:     }
 92:   }, [])
 93: 
 94:   useEffect(() => {
 95:     if (!auth) {
 96:       setLoading(false)
 97:       return
 98:     }
 99: 
100:     const unsubscribe = onAuthStateChanged(auth, async (firebaseUser) => {
101:       setUser(firebaseUser)
102: 
103:       if (firebaseUser) {
104:         await syncConBack(firebaseUser)
105:       } else {
106:         setPerfil(null)
107:       }
108: 
109:       setLoading(false)
110:     })
111: 
112:     return () => unsubscribe()
113:   }, [syncConBack])
114: 
115:   const loginWithGoogle = async () => {
116:     if (!auth || !googleProvider) {
117:       console.warn("[auth] Firebase no está configurado (faltan NEXT_PUBLIC_FIREBASE_*)")
118:       return
119:     }
120:     try {
121:       await signInWithPopup(auth, googleProvider)
122:       // onAuthStateChanged se encarga del syncConBack
123:     } catch (error) {
124:       if (!isIgnoredFirebaseError(error)) {
125:         console.error("[auth] Error en login con Google:", error)
126:         throw error
127:       }
128:     }
129:   }
130: 
131:   const logout = async () => {
132:     if (!auth) return
133:     await firebaseSignOut(auth)
134:     setPerfil(null)
135:   }
136: 
137:   /** Re-fetcha el perfil desde ciudadano-back (usar tras PATCH /me). */
138:   const refreshPerfil = useCallback(async () => {
139:     if (!user) return
140:     try {
141:       const idToken = await user.getIdToken()
142:       const ciudadanoDB = await getMiPerfil(idToken)
143:       setPerfil(ciudadanoDB)
144:     } catch (err) {
145:       console.error("[auth] Error al refrescar perfil:", err)
146:     }
147:   }, [user])
148: 
149:   return (
150:     <AuthContext.Provider
151:       value={{ user, perfil, loading, loginWithGoogle, logout, refreshPerfil }}
152:     >
153:       {children}
154:     </AuthContext.Provider>
155:   )
156: }
157: 
158: export function useAuth(): AuthContextValue {
159:   const ctx = useContext(AuthContext)
160:   if (!ctx) throw new Error("useAuth debe usarse dentro de <AuthProvider>")
161:   return ctx
162: }
