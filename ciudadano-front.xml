  7: gsap.registerPlugin(ScrollTrigger)
  8: 
  9: function randomBit(): string {
 10:   return Math.random() < 0.5 ? "0" : "1"
 11: }
 12: 
 13: interface UseCodeTitleOptions {
 14:   scrambleCycles?: number
 15:   stagger?: number
 16:   cycleDuration?: number
 17:   triggerStart?: string
 18:   immediate?: boolean
 19: }
 20: 
 21: export function useCodeTitle(options: UseCodeTitleOptions = {}) {
 22:   const ref = useRef<HTMLElement | null>(null)
 23: 
 24:   useEffect(() => {
 25:     if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
 26: 
 27:     const el = ref.current
 28:     if (!el) return
 29: 
 30:     const {
 31:       scrambleCycles = 8,
 32:       stagger        = 0.042,
 33:       cycleDuration  = 0.038,
 34:       triggerStart   = "top 82%",
 35:       immediate      = false,
 36:     } = options
 37: 
 38:     const originalHTML = el.innerHTML
 39: 
 40:     type Slot = {
 41:       char: string
 42:       isSpace: boolean
 43:       isAccent: boolean
 44:       span: HTMLSpanElement
 45:     }
 46: 
 47:     const slots: Slot[] = []
 48: 
 49:     function processTextNode(textNode: Text, insideAccent: boolean) {
 50:       const text = textNode.textContent ?? ""
 51:       if (!text) return
 52:       const fragment = document.createDocumentFragment()
 53:       for (const char of text) {
 54:         const isSpace = char === " " || char === "\u00A0"
 55:         const sp = document.createElement("span")
 56:         sp.style.cssText = "display:inline-block;white-space:pre;"
 57:         sp.textContent = isSpace ? "\u00A0" : char
 58:         slots.push({ char: isSpace ? "\u00A0" : char, isSpace, isAccent: insideAccent, span: sp })
 59:         fragment.appendChild(sp)
 60:       }
 61:       textNode.parentNode?.replaceChild(fragment, textNode)
 62:     }
 63: 
 64:     function walkNode(node: Node, insideAccent: boolean) {
 65:       if (node.nodeType === Node.TEXT_NODE) {
 66:         processTextNode(node as Text, insideAccent)
 67:         return
 68:       }
 69:       if (node.nodeType === Node.ELEMENT_NODE) {
 70:         const isAccent = insideAccent || (node as HTMLElement).tagName === "SPAN"
 71:         const children = Array.from(node.childNodes)
 72:         for (const child of children) walkNode(child, isAccent)
 73:       }
 74:     }
 75: 
 76:     walkNode(el, false)
 77: 
 78:     gsap.set(slots.map((s) => s.span), { opacity: 0 })
 79: 
 80:     const tl = gsap.timeline({ paused: true })
 81: 
 82:     slots.forEach((slot, i) => {
 83:       const { span, char, isSpace, isAccent } = slot
 84:       const delay = i * stagger
 85: 
 86:       if (isSpace) {
 87:         tl.to(span, { opacity: 1, duration: 0 }, delay)
 88:         return
 89:       }
 90: 
 91:       for (let c = 0; c < scrambleCycles; c++) {
 92:         tl.to(span, {
 93:           opacity: 1,
 94:           duration: 0,
 95:           onStart() {
 96:             span.textContent = randomBit()
 97:             span.style.color = isAccent
 98:               ? "rgba(38,167,252,0.75)"
 99:               : "rgba(38,167,252,0.55)"
100:           },
101:         }, delay + c * cycleDuration)
102:       }
103: 
104:       tl.to(span, {
105:         duration: 0,
106:         onStart() {
107:           span.textContent = char
108:           span.style.color = ""
109:         },
110:       }, delay + scrambleCycles * cycleDuration)
111: 
112:       tl.fromTo(
113:         span,
114:         { opacity: 0.55 },
115:         { opacity: 1, duration: 0.1, ease: "power1.out" },
116:         delay + scrambleCycles * cycleDuration,
117:       )
118:     })
119: 
120:     if (immediate) {
121:       tl.play()
122:     } else {
123:       ScrollTrigger.create({
124:         trigger: el,
125:         start: triggerStart,
126:         once: true,
127:         onEnter: () => tl.play(),
128:       })
129:     }
130: 
131:     return () => {
132:       tl.kill()
133:       ScrollTrigger.getAll().forEach((t) => {
134:         if (t.vars.trigger === el) t.kill()
135:       })
136:       el.innerHTML = originalHTML
137:     }
138:   // eslint-disable-next-line react-hooks/exhaustive-deps
139:   }, [])
140: 
141:   return ref
142: }
