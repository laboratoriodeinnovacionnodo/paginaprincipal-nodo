```bash
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # 04_ciudadano-front_fix-runtime.sh
  4: # Corrige 2 errores de runtime en ciudadano-front:
  5: #
  6: #   ERROR 1 — /_vercel/insights/script.js 404
  7: #     @vercel/analytics solo funciona en Vercel. En Docker/self-hosted
  8: #     el script nunca existe → error en consola en cada visita.
  9: #     Fix: eliminar el componente <Analytics /> de layout.tsx
 10: #
 11: #   ERROR 2 — Cannot read properties of undefined (reading 'toLocaleString')
 12: #     CounterStat espera prop "end" pero hero-section.tsx la llama con "value".
 13: #     Fix: unificar la prop → CounterStat acepta ambas (value | end) con fallback 0
 14: # =============================================================================
 15: set -euo pipefail
 16: 
 17: echo "🔧 [ciudadano-front] Corrigiendo errores de runtime..."
 18: 
 19: # ─── ERROR 1: eliminar @vercel/analytics de layout.tsx ───────────────────────
 20: echo ""
 21: echo "📌 Fix 1: Removiendo Vercel Analytics de layout.tsx..."
 22: 
 23: LAYOUT="app/layout.tsx"
 24: 
 25: if [ ! -f "$LAYOUT" ]; then
 26:   echo "❌ No se encontró $LAYOUT"
 27:   exit 1
 28: fi
 29: 
 30: cp "$LAYOUT" "${LAYOUT}.bak"
 31: 
 32: # Eliminar el import de Analytics
 33: sed -i 's/^import { Analytics } from "@vercel\/analytics\/next".*$//' "$LAYOUT"
 34: sed -i 's/^import { Analytics } from "@vercel\/analytics\/react".*$//' "$LAYOUT"
 35: 
 36: # Eliminar el tag <Analytics /> (con o sin espacios/props)
 37: sed -i 's/[[:space:]]*<Analytics[^>]*\/>[[:space:]]*//' "$LAYOUT"
 38: sed -i 's/[[:space:]]*<Analytics[^>]*>[^<]*<\/Analytics>[[:space:]]*//' "$LAYOUT"
 39: 
 40: echo "✅ Analytics removido"
 41: 
 42: # ─── ERROR 2: CounterStat — unificar prop end/value ──────────────────────────
 43: echo ""
 44: echo "📌 Fix 2: Corrigiendo CounterStat para aceptar prop 'value' y 'end'..."
 45: 
 46: COUNTER="components/counter-stat.tsx"
 47: 
 48: if [ ! -f "$COUNTER" ]; then
 49:   echo "❌ No se encontró $COUNTER"
 50:   exit 1
 51: fi
 52: 
 53: cp "$COUNTER" "${COUNTER}.bak"
 54: 
 55: cat > "$COUNTER" << 'ENDOFFILE'
 56: "use client"
 57: 
 58: import { useEffect, useRef, useState } from "react"
 59: 
 60: interface CounterStatProps {
 61:   /** Valor final del contador. Acepta "end" o "value" indistintamente. */
 62:   end?:      number
 63:   value?:    number
 64:   label:     string
 65:   suffix?:   string
 66:   duration?: number
 67: }
 68: 
 69: export function CounterStat({
 70:   end,
 71:   value,
 72:   label,
 73:   suffix = "+",
 74:   duration = 2000,
 75: }: CounterStatProps) {
 76:   // Acepta end o value; si ninguno llega usa 0 como fallback seguro
 77:   const target = end ?? value ?? 0
 78: 
 79:   const [count, setCount]         = useState(0)
 80:   const [isVisible, setIsVisible] = useState(false)
 81:   const ref                       = useRef<HTMLDivElement>(null)
 82: 
 83:   // IntersectionObserver — arranca la animación cuando entra en pantalla
 84:   useEffect(() => {
 85:     const observer = new IntersectionObserver(
 86:       ([entry]) => {
 87:         if (entry.isIntersecting && !isVisible) setIsVisible(true)
 88:       },
 89:       { threshold: 0.3 },
 90:     )
 91:     if (ref.current) observer.observe(ref.current)
 92:     return () => { if (ref.current) observer.unobserve(ref.current) }
 93:   }, [isVisible])
 94: 
 95:   // Animación de conteo
 96:   useEffect(() => {
 97:     if (!isVisible || target === 0) return
 98: 
 99:     const startTime = Date.now()
100:     const endTime   = startTime + duration
101: 
102:     const updateCount = () => {
103:       const now      = Date.now()
104:       const progress = Math.min((now - startTime) / duration, 1)
105:       // Ease out quart
106:       const eased    = 1 - Math.pow(1 - progress, 4)
107: 
108:       setCount(Math.floor(eased * target))
109: 
110:       if (now < endTime) {
111:         requestAnimationFrame(updateCount)
112:       } else {
113:         setCount(target)
114:       }
115:     }
116: 
117:     requestAnimationFrame(updateCount)
118:   }, [isVisible, target, duration])
119: 
120:   return (
121:     <div ref={ref}>
122:       <div className="text-4xl md:text-5xl font-bold text-primary">
123:         {count.toLocaleString("es-AR")}
124:         {suffix}
125:       </div>
126:       <div className="text-sm text-muted-foreground mt-1 text-white/75">{label}</div>
127:     </div>
128:   )
129: }
130: ENDOFFILE
131: 
132: echo "✅ CounterStat corregido (acepta 'end' y 'value')"
133: 
134: # ─── Verificar build ──────────────────────────────────────────────────────────
135: echo ""
136: echo "🔨 Verificando build..."
137: pnpm build
138: 
139: echo ""
140: echo "✅ [ciudadano-front] Errores de runtime corregidos."
141: echo ""
142: echo "📋 Archivos modificados:"
143: echo "   app/layout.tsx               ← Analytics removido"
144: echo "   components/counter-stat.tsx  ← prop end|value con fallback 0"
145: EOF
