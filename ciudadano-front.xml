38:       window.location.href = url
39:     } catch {
40:       const base = (process.env.NEXT_PUBLIC_REGISTRO_URL ?? "").replace(/\/$/, "")
41:       window.location.href = `${base}/preinscripciones/${slug}`
42:     } finally {
43:       setLoading(false)
44:     }
45:   }, [slug, user])
46: 
47:   return (
