40:   // Mientras no está montado mostrar botón idéntico al SSR (sin interactividad)
41:   if (!mounted) {
42:     return (
43:       <Button size="lg" className="w-full gap-2 bg-[#1c8fe0] hover:bg-[#1c8fe0] text-white">
