 63: // ── Fetch helper ──────────────────────────────────────────────────────────────
 64: 
 65: async function apiFetch<T>(
 66:   path: string,
 67:   idToken: string,
 68:   options: RequestInit = {},
 69: ): Promise<T> {
 70:   if (!BASE || BASE === "/api") {
 71:     throw new Error(
 72:       "[ciudadano-api] NEXT_PUBLIC_CIUDADANO_API_URL no está configurada",
 73:     )
 74:   }
 75: 
 76:   const res = await fetch(`${BASE}${path}`, {
 77:     ...options,
 78:     headers: {
 79:       "Content-Type": "application/json",
 80:       Authorization: `Bearer ${idToken}`,
 81:       ...(options.headers ?? {}),
 82:     },
 83:   })
 84: 
 85:   if (!res.ok) {
 86:     const body = await res.text().catch(() => "")
 87:     throw new Error(`[ciudadano-api] ${res.status} ${path} — ${body}`)
 88:   }
 89: 
 90:   const json = await res.json()
 91:   // El back envuelve en { data, statusCode, timestamp }
 92:   return (json?.data ?? json) as T
 93: }
