## File: lib/cursos/filters.ts
```typescript
 1: import type { Curso, Modalidad } from "./types"
 2: 
 3: export const filterCursos = (cursos: Curso[], modalidad: Modalidad, tags: string[], busqueda: string): Curso[] => {
 4:   return cursos.filter((curso) => {
 5:     const matchModalidad = modalidad === "todos" || curso.modalidad === modalidad
 6:     const matchTags = tags.length === 0 || tags.some((tag) => curso.tags.includes(tag))
 7:     const matchBusqueda =
 8:       busqueda === "" ||
 9:       curso.titulo.toLowerCase().includes(busqueda.toLowerCase()) ||
10:       curso.descripcion.toLowerCase().includes(busqueda.toLowerCase()) ||
11:       curso.tags.some((tag) => tag.toLowerCase().includes(busqueda.toLowerCase()))
12:     return matchModalidad && matchTags && matchBusqueda
13:   })
14: }
15: 
16: export const getTagsByModalidad = (
17:   todosCursos: Curso[],
18:   cursosPresenciales: Curso[],
19:   cursosVirtuales: Curso[],
20:   modalidad: Modalidad,
21: ): string[] => {
22:   let cursosParaTags: Curso[] = []
23: 
24:   switch (modalidad) {
25:     case "todos":
26:       cursosParaTags = todosCursos
27:       break
28:     case "presencial":
29:       cursosParaTags = cursosPresenciales
30:       break
31:     case "virtual":
32:       cursosParaTags = cursosVirtuales
33:       break
34:   }
35: 
36:   const tagsSet = new Set<string>()
37:   cursosParaTags.forEach((curso) => {
38:     curso.tags.forEach((tag) => tagsSet.add(tag))
39:   })
40: 
41:   return Array.from(tagsSet).sort()
42: }
