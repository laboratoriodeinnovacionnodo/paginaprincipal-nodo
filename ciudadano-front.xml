```typescript
  1: "use client"
  2: 
  3: /**
  4:  * <CodeTitle>
  5:  *
  6:  * Animación premium: cada palabra sube suavemente desde abajo
  7:  * con fade-in + blur dissolve, en cascada de izquierda a derecha.
  8:  *
  9:  * - Sin dependencias externas
 10:  * - Respeta prefers-reduced-motion
 11:  * - Compatible con <span> de accent color (text-primary, etc.)
 12:  * - IntersectionObserver para páginas con scroll
 13:  * - `immediate` para heroes above-the-fold
 14:  */
 15: 
 16: import { useEffect, useRef, type ReactNode } from "react"
 17: 
 18: type Tag = "h1" | "h2" | "h3"
 19: 
 20: interface Props {
 21:   as?: Tag
 22:   className?: string
 23:   children: ReactNode
 24:   /** Disparar sin esperar scroll (hero above-the-fold) */
 25:   immediate?: boolean
 26:   /** ms entre palabras. Default: 80 */
 27:   stagger?: number
 28:   /** ms que dura el reveal de cada palabra. Default: 600 */
 29:   duration?: number
 30: }
 31: 
 32: export function CodeTitle({
 33:   as: Tag = "h1",
 34:   className = "",
 35:   children,
 36:   immediate = false,
 37:   stagger = 80,
 38:   duration = 600,
 39: }: Props) {
 40:   const ref = useRef<HTMLElement>(null)
 41: 
 42:   useEffect(() => {
 43:     const el = ref.current
 44:     if (!el) return
 45:     if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
 46: 
 47:     // ── Reconstruir el heading como lista de word-spans ────────
 48:     // Preserva los <span class="text-primary"> y similares como
 49:     // wrappers de color — solo fragmentamos su contenido en palabras.
 50: 
 51:     const originalHTML = el.innerHTML
 52: 
 53:     type WordSlot = {
 54:       span: HTMLSpanElement
 55:       accentClass: string   // clase CSS del wrapper accent, si existe
 56:       isAccent: boolean
 57:     }
 58: 
 59:     const wordSlots: WordSlot[] = []
 60: 
 61:     // Procesa un fragmento de texto, dividiendo en palabras + espacios.
 62:     // Cada "token" (palabra o espacio) se convierte en un span animable.
 63:     function createWordSpan(word: string, accentClass: string, isAccent: boolean): HTMLSpanElement {
 64:       const sp = document.createElement("span")
 65:       // inline-block para poder transformar verticalmente
 66:       // overflow hidden contiene el movimiento dentro del bounding box
 67:       sp.style.cssText = [
 68:         "display:inline-block",
 69:         "overflow:hidden",
 70:         "vertical-align:bottom",
 71:         // El padding-bottom compensa el overflow:hidden que recorta descenders
 72:         "padding-bottom:0.1em",
 73:         "margin-bottom:-0.1em",
 74:       ].join(";")
 75: 
 76:       // Span interno — este es el que se anima
 77:       const inner = document.createElement("span")
 78:       inner.style.cssText = [
 79:         "display:inline-block",
 80:         "opacity:0",
 81:         "transform:translateY(60%) skewY(3deg)",
 82:         "filter:blur(4px)",
 83:         `transition:opacity ${duration}ms cubic-bezier(0.16,1,0.3,1), transform ${duration}ms cubic-bezier(0.16,1,0.3,1), filter ${duration}ms cubic-bezier(0.16,1,0.3,1)`,
 84:         "will-change:transform,opacity,filter",
 85:       ].join(";")
 86: 
 87:       if (isAccent && accentClass) {
 88:         inner.className = accentClass
 89:       }
 90: 
 91:       inner.textContent = word
 92:       sp.appendChild(inner)
 93: 
 94:       wordSlots.push({ span: inner, accentClass, isAccent })
 95:       return sp
 96:     }
 97: 
 98:     // Tokenizar texto en palabras y espacios
 99:     function tokenize(text: string): string[] {
100:       // Dividir manteniendo espacios como tokens separados
101:       return text.split(/(\s+)/)
102:     }
103: 
104:     // Recorrer el DOM real y reemplazar TextNodes con word-spans
105:     function processText(node: Text, accentClass: string) {
106:       const text = node.textContent ?? ""
107:       if (!text.trim() && text.length === 0) return
108: 
109:       const tokens = tokenize(text)
110:       const frag = document.createDocumentFragment()
111: 
112:       for (const token of tokens) {
113:         if (!token) continue
114:         if (/^\s+$/.test(token)) {
115:           // Espacio: texto plano, no se anima
116:           frag.appendChild(document.createTextNode(token))
117:         } else {
118:           const ws = createWordSpan(token, accentClass, accentClass.length > 0)
119:           frag.appendChild(ws)
120:         }
121:       }
122: 
123:       node.parentNode?.replaceChild(frag, node)
124:     }
125: 
126:     function walk(node: Node, accentClass: string) {
127:       if (node.nodeType === Node.TEXT_NODE) {
128:         processText(node as Text, accentClass)
129:         return
130:       }
131:       if (node.nodeType === Node.ELEMENT_NODE) {
132:         const el = node as HTMLElement
133:         // Si es un span, capturar su clase para propagarla a los inners
134:         const cls = el.tagName === "SPAN" ? el.className : accentClass
135:         // Snapshot antes de mutar
136:         const kids = Array.from(el.childNodes)
137:         for (const k of kids) walk(k, cls)
138:       }
139:     }
140: 
141:     walk(el, "")
142: 
143:     // ── Trigger ────────────────────────────────────────────────
144:     let timeouts: ReturnType<typeof setTimeout>[] = []
145: 
146:     function reveal() {
147:       wordSlots.forEach(({ span }, i) => {
148:         const id = setTimeout(() => {
149:           span.style.opacity = "1"
150:           span.style.transform = "translateY(0%) skewY(0deg)"
151:           span.style.filter = "blur(0px)"
152:         }, i * stagger)
153:         timeouts.push(id)
154:       })
155:     }
156: 
157:     if (immediate) {
158:       // Pequeño delay para que el DOM esté pintado
159:       const id = setTimeout(reveal, 50)
160:       timeouts.push(id)
161:     } else {
162:       const obs = new IntersectionObserver(
163:         entries => {
164:           if (entries[0].isIntersecting) {
165:             obs.disconnect()
166:             reveal()
167:           }
168:         },
169:         { threshold: 0.15 }
170:       )
171:       obs.observe(el)
172: 
173:       return () => {
174:         timeouts.forEach(clearTimeout)
175:         obs.disconnect()
176:         el.innerHTML = originalHTML
177:       }
178:     }
179: 
180:     return () => {
181:       timeouts.forEach(clearTimeout)
182:       el.innerHTML = originalHTML
183:     }
184:   // eslint-disable-next-line react-hooks/exhaustive-deps
185:   }, [])
186: 
187:   return (
188:     <Tag
189:       // eslint-disable-next-line @typescript-eslint/no-explicit-any
190:       ref={ref as any}
191:       className={className}
192:     >
193:       {children}
194:     </Tag>
195:   )
196: }
