 1: /**
 2:  * lib/registro-link.ts
 3:  *
 4:  * Construye la URL de registro-front con ?ctoken=<Firebase idToken>
 5:  * para SSO silencioso — registro-front reconoce al ciudadano sin pedirle login.
 6:  */
 7: import type { User } from "firebase/auth"
 8: 
 9: const REGISTRO_BASE =
10:   (process.env.NEXT_PUBLIC_REGISTRO_URL ?? "").replace(/\/$/, "")
11: 
12: /**
13:  * Async — usar en onClick de botones de inscripción.
14:  * Obtiene un token fresco y construye la URL completa.
15:  */
16: export async function buildRegistroUrl(slug: string, user: User | null): Promise<string> {
17:   const base = `${REGISTRO_BASE}/preinscripciones/${slug}`
18:   if (!user || !REGISTRO_BASE) return base
19:   try {
20:     const token = await user.getIdToken(true)
21:     return `${base}?ctoken=${encodeURIComponent(token)}`
22:   } catch {
23:     return base
24:   }
25: }
