## File: components/counter-stat.tsx
```typescript
 1: "use client"
 2: 
 3: import { useEffect, useRef, useState } from "react"
 4: 
 5: interface CounterStatProps {
 6:   /** Valor final del contador. Acepta "end" o "value" indistintamente. */
 7:   end?:      number
 8:   value?:    number
 9:   label:     string
10:   suffix?:   string
11:   duration?: number
12: }
13: 
14: export function CounterStat({
15:   end,
16:   value,
17:   label,
18:   suffix = "+",
19:   duration = 2000,
20: }: CounterStatProps) {
21:   // Acepta end o value; si ninguno llega usa 0 como fallback seguro
22:   const target = end ?? value ?? 0
23: 
24:   const [count, setCount]         = useState(0)
25:   const [isVisible, setIsVisible] = useState(false)
26:   const ref                       = useRef<HTMLDivElement>(null)
27: 
28:   // IntersectionObserver — arranca la animación cuando entra en pantalla
29:   useEffect(() => {
30:     const observer = new IntersectionObserver(
31:       ([entry]) => {
32:         if (entry.isIntersecting && !isVisible) setIsVisible(true)
33:       },
34:       { threshold: 0.3 },
35:     )
36:     if (ref.current) observer.observe(ref.current)
37:     return () => { if (ref.current) observer.unobserve(ref.current) }
38:   }, [isVisible])
39: 
40:   // Animación de conteo
41:   useEffect(() => {
42:     if (!isVisible || target === 0) return
43: 
44:     const startTime = Date.now()
45:     const endTime   = startTime + duration
46: 
47:     const updateCount = () => {
48:       const now      = Date.now()
49:       const progress = Math.min((now - startTime) / duration, 1)
50:       // Ease out quart
51:       const eased    = 1 - Math.pow(1 - progress, 4)
52: 
53:       setCount(Math.floor(eased * target))
54: 
55:       if (now < endTime) {
56:         requestAnimationFrame(updateCount)
57:       } else {
58:         setCount(target)
59:       }
60:     }
61: 
62:     requestAnimationFrame(updateCount)
63:   }, [isVisible, target, duration])
64: 
65:   return (
66:     <div ref={ref}>
67:       <div className="text-4xl md:text-5xl font-bold text-primary">
68:         {count.toLocaleString("es-AR")}
69:         {suffix}
70:       </div>
71:       <div className="text-sm text-muted-foreground mt-1 text-white/75">{label}</div>
72:     </div>
73:   )
74: }
