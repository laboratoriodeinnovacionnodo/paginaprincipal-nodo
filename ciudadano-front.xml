12: 
13: export async function POST(req: NextRequest) {
14:   try {
15:     const { messages } = await req.json()
16: 
17:     if (!messages || !Array.isArray(messages)) {
18:       return NextResponse.json({ error: "Mensajes inválidos" }, { status: 400 })
19:     }
20: 
21:     const completion = await groq.chat.completions.create({
22:       model: process.env.NEXT_GROQ_MODEL || "llama-3.3-70b-versatile",
23:       messages: [
24:         { role: "system", content: SYSTEM_PROMPT },
25:         ...messages,
26:       ],
27:       max_tokens: 1024,
28:       temperature: 0.7,
29:     })
30: 
31:     const response = completion.choices[0]?.message?.content
32: 
33:     if (!response) {
34:       return NextResponse.json({ error: "Sin respuesta del modelo" }, { status: 500 })
35:     }
36: 
37:     return NextResponse.json({ response })
38:   } catch (error) {
39:     console.error("Groq API error:", error)
40:     return NextResponse.json({ error: "Error interno del servidor" }, { status: 500 })
