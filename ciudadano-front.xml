 76:     ...options,
 77:     headers: {
 78:       "Content-Type": "application/json",
 79:       Authorization: `Bearer ${idToken}`,
 80:       ...(options.headers ?? {}),
 81:     },
 82:   })
 83: 
 84:   if (!res.ok) {
 85:     const body = await res.text().catch(() => "")
 86:     throw new Error(`[ciudadano-api] ${res.status} ${path} — ${body}`)
 87:   }
 88: 
 89:   const json = await res.json()
 90:   // El back envuelve en { data, statusCode, timestamp }
 91:   return (json?.data ?? json) as T
 92: }
