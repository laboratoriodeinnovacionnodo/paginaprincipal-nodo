106:       "[ciudadano-api] NEXT_PUBLIC_CIUDADANO_API_URL no está configurada",
107:     )
108:   }
109: 
110:   const res = await fetch(`${BASE}/auth/login`, {
111:     method: "POST",
112:     headers: { "Content-Type": "application/json" },
113:     body: JSON.stringify({ idToken }),
114:   })
115: 
116:   if (!res.ok) {
117:     const body = await res.text().catch(() => "")
118:     throw new Error(`[ciudadano-api] login ${res.status} — ${body}`)
119:   }
120: 
121:   const json = await res.json()
122:   // El back devuelve { ciudadano, firebaseUid }
123:   const payload = json?.data ?? json
124:   return payload.ciudadano as CiudadanoDB
125: }
